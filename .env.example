# Environment variables for the Slack Finance RAG Bot.
# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.
#
# NOTE: n8n runs in Docker and cannot read this file directly.
# The values here must also be added to C:\n8n-local\.env (see that file
# for instructions). This file serves as a reference and backup copy.

# --- n8n Credential (add via n8n UI: Credentials → New → Anthropic) --------
# Not stored here at runtime — lives in n8n's encrypted credential store.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- n8n Environment Variable (add to n8n-local/.env + docker-compose.yml) -
# Source: api.slack.com → your Slack app → Basic Information → Signing Secret
# Used by the "Verify Slack Signature" Code node for HMAC-SHA256 verification.
SLACK_SIGNING_SECRET=your_slack_signing_secret_here

# --- Webhook URL (for reference — set in Slack app slash command config) ----
# Source: your ngrok domain or production URL
WEBHOOK_BASE_URL=https://your-ngrok-or-domain-here.ngrok-free.dev
