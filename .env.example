# Non-secret runtime settings for a self-hosted n8n instance.
#
# Store the Anthropic API key and Slack signing secret in n8n Credentials.
# Do not put either secret in this file or in the project repository.

# Required so the verification Code node can perform constant-time comparison.
NODE_FUNCTION_ALLOW_BUILTIN=crypto

# Guardrail: workflow nodes must not read host environment variables.
N8N_BLOCK_ENV_ACCESS_IN_NODE=true

# --- Webhook URL (for reference — set in Slack app slash command config) ----
# Source: your ngrok domain or production URL
WEBHOOK_BASE_URL=https://your-ngrok-or-domain-here.ngrok-free.dev
